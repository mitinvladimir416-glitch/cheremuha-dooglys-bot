# Скопируйте этот файл в .env и впишите реальные значения.
# Файл .env НЕ коммитить — он уже в .gitignore.

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@host:5432/cheremuha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cheremuha
DB_USER=postgres
DB_PASSWORD=

# --- Backend (Express) ---
PORT=3000
JWT_SECRET=придумайте_длинную_случайную_строку_здесь
NODE_ENV=production

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- OpenRouter (DeepSeek AI-парсинг) ---
OPENROUTER_API_KEY=

# --- Dooglys API ---
DOOGLYS_ACCESS_TOKEN=
DOOGLYS_DOMAIN=cheremukha
DOOGLYS_API_BASE=https://cheremukha.dooglys.com/api/v1

# --- Backend URL (для бота и фронтенда) ---
BACKEND_URL=http://localhost:3000

# --- Первый админ-аккаунт (создаётся при первом запуске) ---
ADMIN_LOGIN=
ADMIN_PASSWORD=
